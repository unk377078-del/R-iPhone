rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
        'customerName', 'customerPhone', 'deliveryMethod', 'items', 'subtotal', 'total', 'status', 'createdAt'
      ]) && request.resource.data.customerName is string
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() <= 32
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'قيد المراجعة والتجهيز';
      allow read, update, delete: if isAdmin();
    }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotional_broadcasts/{broadcastId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /device_tokens/{tokenId} {
      allow read, delete: if isAdmin();
      allow create, update: if request.resource.data.keys().hasOnly(['token', 'updatedAt', 'platform'])
        && request.resource.data.token is string
        && request.resource.data.platform in ['ios', 'android'];
    }
    match /users/{userId} {
      allow read, write: if (signedIn() && request.auth.uid == userId) || isAdmin();
    }
  }
}
